# Copy to .env at the repo root (docker compose reads it automatically) and fill in your key.
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

# Optional - paid fallback search provider for when SearXNG's engines are rate-limited/blocked
# (get a key at serpapi.com). Leave unset to run on SearXNG alone.
SERPAPI_KEY=
