---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-canvas text-ink antialiased">
    <slot />
    <script>
      import Lenis from "lenis";

      // Global lerped/inertia scroll — the landing page has nothing to scroll (single viewport,
      // by design) so this is a no-op there; how-it-works and the /app flow (candidate lists,
      // long profiles) get the smooth-follow feel instead of the browser's discrete scroll.
      const lenis = new Lenis({ lerp: 0.1 });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);
    </script>
  </body>
</html>
